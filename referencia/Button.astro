---
const variantes = {
  sun: "bg-sun text-on-accent",
  leaf: "bg-leaf text-on-accent",
  ghost: "bg-card text-ink",
} as const;

interface Props {
  href?: string;
  variant?: keyof typeof variantes;
  class?: string;
}
const { href, variant = "sun", class: className } = Astro.props;
const Element = href ? "a" : "button";
---
<Element
  href={href}
  class:list={[
    "inline-block border-3 border-ink px-4 py-2 font-bold shadow-hard-sm",
    "transition duration-100 motion-reduce:transition-none",
    "hover:translate-px hover:shadow-[2px_2px_0_var(--ink)]",
    variantes[variant],
    className,
  ]}
>
  <slot />
</Element>
