---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Card from "../components/Card.astro";
import Tag from "../components/Tag.astro";
import Button from "../components/Button.astro";
---
<BaseLayout title="Jardín digital">
  <main class="mx-auto max-w-4xl px-5 py-10">
    <header class="mb-12 flex items-center justify-between">
      <span class="font-pixel text-xs">jardín digital</span>
      <ThemeToggle />
    </header>

    <h1 class="mb-6 text-5xl font-bold tracking-tight">Un jardín de ideas a medio crecer</h1>
    <Button href="#notas">Pasear por el jardín</Button>

    <section id="notas" class="mt-16 grid gap-6 sm:grid-cols-2">
      <Card href="#">
        <Tag tema="frontend">Frontend</Tag>
        <h2 class="text-lg font-bold">Container queries sin miedo</h2>
        <p class="text-muted">Cómo dejé de pensar en breakpoints.</p>
      </Card>
      <Card href="#">
        <Tag tema="musica">Música</Tag>
        <h2 class="text-lg font-bold">Playlist de otoño</h2>
        <p class="text-muted">Una lista que crece con cada hallazgo.</p>
      </Card>
    </section>
  </main>
</BaseLayout>
