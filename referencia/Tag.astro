---
// Las clases van completas en el mapa para que Tailwind las detecte
const colores = {
  frontend: "bg-leaf",
  producto: "bg-sun",
  videojuegos: "bg-bubble",
  cultura: "bg-tangerine",
  actualidad: "bg-sky",
  musica: "bg-lilac",
} as const;

interface Props {
  tema: keyof typeof colores;
  class?: string;
}
const { tema, class: className } = Astro.props;
---
<span
  class:list={[
    "inline-block self-start border-2 border-ink px-2 text-xs font-bold text-on-accent",
    colores[tema],
    className,
  ]}
>
  <slot />
</span>
