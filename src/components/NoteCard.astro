---
import Card from "./Card.astro";
import Tag from "./Tag.astro";
import StageBadge from "./StageBadge.astro";
import { formatDate, isoDate } from "../lib/garden";
import { lastWatered, type Note } from "../lib/notes";

interface Props {
  note: Note;
  headingLevel?: "h2" | "h3";
}
const { note, headingLevel: Heading = "h3" } = Astro.props;
const { title, summary, topic, stage } = note.data;
const watered = lastWatered(note);
---
<Card href={`/notas/${note.id}/`}>
  <div class="flex items-center justify-between gap-3">
    <Tag topic={topic} />
    <StageBadge stage={stage} />
  </div>
  <Heading class="text-xl leading-snug font-bold">{title}</Heading>
  <p class="text-muted">{summary}</p>
  <p class="mt-auto pt-2 text-sm text-muted">
    Regada el <time datetime={isoDate(watered)}>{formatDate(watered)}</time>
  </p>
</Card>
