---
import PixelSprite from "./PixelSprite.astro";
import ThemeToggle from "./ThemeToggle.astro";
---
<header class="flex flex-wrap items-center justify-between gap-4 py-8">
  <a href="/" class="group flex items-center gap-3" aria-label="Jardín digital, ir a la portada">
    <span class="brutal grid size-12 place-items-center p-1 shadow-hard-sm transition group-hover:-rotate-6 motion-reduce:transition-none">
      <PixelSprite name="brote" size={36} />
    </span>
    <span class="font-pixel text-[0.7rem] leading-relaxed">Jorge González<br>Mi jardín digital</span>
  </a>
  <ThemeToggle />
</header>
